# Database Configuration Template
# Copy this file to '.env' and fill in your local PostgreSQL credentials

DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daily_expense_tracker

# Database connection URL string format:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/daily_expense_tracker
